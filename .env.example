# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_from_botfather

# Admin Telegram ID (your personal Telegram ID for admin commands)
ADMIN_TELEGRAM_ID=123456789

# Database path (optional, defaults to bot.db)
DATABASE_PATH=bot.db

# M-Pesa Daraja API Configuration
# Get these from https://developer.safaricom.co.ke/
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=your_paybill_or_till_number
MPESA_PASSKEY=your_lipa_na_mpesa_passkey

# For B2C disbursements (releasing funds to sellers)
MPESA_B2C_INITIATOR=your_b2c_initiator_name
MPESA_B2C_PASSWORD=your_encrypted_b2c_password

# Callback URL for M-Pesa (your Heroku app URL)
MPESA_CALLBACK_URL=https://your-app.herokuapp.com

# Environment: 'sandbox' for testing, 'production' for live
MPESA_ENV=sandbox
